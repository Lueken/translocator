{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "translocator",
  "version": "0.3.0",
  "identifier": "com.tauri-app.translocator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Translocator",
        "width": 1140,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https://res.cloudinary.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://translocator.app/launcher/latest.json",
        "https://thequirevs.com/launcher/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDMDVEMjg3MTdFOTFEQQpSV1Rha1g1eEtGM0FDaURlcEVpUE9YMTVGTnpjVGxTcEc3Si9Rcmx3ZDhFTEdIT1diNVBpZ0xFdQo="
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": ["../LICENSE"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
